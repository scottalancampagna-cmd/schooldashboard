# Copy this file to .env and fill in your values
# Never commit .env to git

# OpenWeatherMap API key (free tier works)
# Get one at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_key_here

# Google Calendar iCal URL (secret address — keep private!)
# Google Calendar → Settings → your calendar → Integrate calendar → Secret address in iCal format
GCAL_ICAL_URL=your_ical_url_here

# Upstash Redis — for the cross-browser visit counter (free tier at console.upstash.com)
# Create a Redis database → copy "REST URL" and "REST Token" from the REST API tab
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
