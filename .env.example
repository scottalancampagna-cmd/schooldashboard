# Copy this file to .env and fill in your values
# Never commit .env to git

# Weather is provided by Open-Meteo (open-meteo.com) — free, no API key required.

# Google Calendar iCal URL (secret address — keep private!)
# Google Calendar → Settings → your calendar → Integrate calendar → Secret address in iCal format
GCAL_ICAL_URL=your_ical_url_here

# GoatCounter — for the cross-browser visit counter (free at goatcounter.com)
# After signing up, set CONFIG.GOATCOUNTER_SITE in index.html to your site code
# No env var needed — tracking is client-side via a script tag
